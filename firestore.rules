rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    match /files/{fileId} {
      // Allow collection list queries
      allow list: if true;
      // Allow single document get and operations
      allow get: if isValidId(fileId);
      allow create, update: if isValidId(fileId);
      allow delete: if isValidId(fileId);

      match /chunks/{chunkId} {
        allow list: if true;
        allow get, create, update, delete: if isValidId(chunkId);
      }
    }
  }
}
